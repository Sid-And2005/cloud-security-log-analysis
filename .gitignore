# Runtime data, logs and archives (never commit datasets or processed logs)
data/*
!data/.gitkeep
!data/incoming/
data/incoming/*
!data/incoming/.gitkeep
*.log

# Terraform state, plans and variable values (may contain secrets)
infra/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
infra/terraform/terraform.tfvars
infra/terraform/*.auto.tfvars
override.tf
override.tf.json
*_override.tf


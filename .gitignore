# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*

# Models: only the deployed, tested model is versioned (2.8 MB).
models/*.joblib

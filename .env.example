# Copy to .env for local development. Never commit .env.
# Values below are placeholders; nothing here is a real credential.

# ---------------------------------------------------------------------------
# 1) Plain local mode (default): CSV storage + local raw archive. Needs nothing.
# ---------------------------------------------------------------------------
APP_ENV=local
# DATA_DIR=data
# MODEL_PATH=models/random_forest_model_v2.joblib
DASHBOARD_REFRESH_SECONDS=3
LOG_LEVEL=INFO
# LOG_FORMAT=text            # "json" in Azure

# ---------------------------------------------------------------------------
# 2) Cloud emulation (docker compose up -d): PostgreSQL + Azurite locally.
#    Uncomment these to run the same code paths used in Azure.
# ---------------------------------------------------------------------------
# STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql://seclog:localdev@127.0.0.1:55432/seclog
# PG_AUTH=password
# ARCHIVE_BACKEND=azure_blob
# AZURE_STORAGE_CONTAINER=raw-logs
# Azurite's publicly documented development key (emulator only, not a secret):
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# ---------------------------------------------------------------------------
# 3) Azure (set on the VM in /etc/seclog/seclog.env by Terraform/cloud-init).
#    No passwords or keys: the VM's managed identity authenticates to both
#    PostgreSQL (Microsoft Entra token) and Blob Storage.
# ---------------------------------------------------------------------------
# APP_ENV=azure
# PGHOST=<server-name>.postgres.database.azure.com
# PGDATABASE=seclog
# PGUSER=<managed-identity-name>
# PGSSLMODE=require
# AZURE_CLIENT_ID=<managed-identity-client-id>
# AZURE_STORAGE_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=raw-logs
# DATA_DIR=/var/lib/seclog

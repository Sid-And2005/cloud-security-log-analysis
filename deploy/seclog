#!/usr/bin/env bash
# Demo / operations helper on the VM (installed to /usr/local/bin/seclog).
#   sudo seclog status                 services + health check
#   sudo seclog traffic on|off         continuous synthetic traffic (producer service)
#   sudo seclog attack <kind>          one attack now: brute_force | request_flood | endpoint_scan
#   sudo seclog logs [consumer|dashboard|producer]   follow live logs
#   sudo seclog stats                  totals in PostgreSQL (events, alerts by severity/source)
#   sudo seclog alerts [n]             the n most recent alerts (default 10)
#   sudo seclog model                  validate the model bundle and feature schema
#   sudo seclog inbox                  files waiting in incoming/ and quarantine/
set -euo pipefail

APP=/opt/seclog/current
as_app() {
  systemd-run --quiet --wait --pipe --collect --uid=seclog --gid=seclog \
    --property=EnvironmentFile=/etc/seclog/seclog.env \
    --setenv=SERVICE_NAME=cli --setenv=LOG_LEVEL=ERROR \
    --working-directory="$APP" "$APP/.venv/bin/python" "$@"
}

[[ $EUID -eq 0 ]] || { echo "run with sudo: sudo seclog $*"; exit 1; }

case "${1:-status}" in
  status)
    systemctl --no-pager --lines=0 status seclog-consumer seclog-dashboard seclog-producer | grep -E "●|Active:" || true
    as_app manage.py health
    ;;
  traffic)
    case "${2:-}" in
      on) systemctl start seclog-producer && echo "Synthetic traffic ON (attack every ~60 s)" ;;
      off) systemctl stop seclog-producer && echo "Synthetic traffic OFF" ;;
      *) echo "usage: sudo seclog traffic on|off"; exit 1 ;;
    esac
    ;;
  attack)
    [[ -n "${2:-}" ]] || { echo "usage: sudo seclog attack brute_force|request_flood|endpoint_scan"; exit 1; }
    as_app producer.py --attack "$2"
    ;;
  logs)
    journalctl -u "seclog-${2:-consumer}" -f -o cat
    ;;
  stats)
    as_app -c 'import json; from src.storage import get_storage; print(json.dumps(get_storage().stats(), indent=2))'
    ;;
  alerts)
    as_app -c "import pandas as pd; from src.storage import get_storage
pd.set_option('display.width', 250); pd.set_option('display.max_colwidth', 60)
cols = ['processed_at', 'source_ip', 'user_id', 'priority', 'detection_source', 'anomaly_probability', 'threat_types']
print(get_storage().load_alerts(${2:-10})[cols].to_string(index=False))"
    ;;
  model)
    as_app manage.py check-model
    ;;
  inbox)
    echo "incoming:   $(find /var/lib/seclog/incoming -name '*.json' | wc -l) file(s) waiting"
    echo "quarantine: $(find /var/lib/seclog/quarantine -name '*.json' | wc -l) file(s) rejected"
    ;;
  *)
    sed -n '2,11p' "$0"
    exit 1
    ;;
esac

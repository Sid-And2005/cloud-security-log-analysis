[Unit]
Description=Security log platform - event consumer (archive, ML scoring, persistence)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=seclog
Group=seclog
WorkingDirectory=/opt/seclog/current
EnvironmentFile=/etc/seclog/seclog.env
Environment=SERVICE_NAME=consumer
ExecStart=/opt/seclog/current/.venv/bin/python consumer.py
Restart=always
RestartSec=5
# SIGTERM lets the consumer finish its current batch.
TimeoutStopSec=60
SyslogIdentifier=seclog-consumer
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/seclog

[Install]
WantedBy=multi-user.target
